# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# --- Embeddings: any OpenAI-compatible /embeddings endpoint -----------------------------
# Default: local Ollama (`ollama pull nomic-embed-text`)
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_BASE_URL=http://localhost:11434/v1
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_API_KEY=ollama
RAG_EMBEDDING_QUERY_PREFIX="search_query: "
RAG_EMBEDDING_DOCUMENT_PREFIX="search_document: "

# --- LLM: any OpenAI-compatible /chat/completions endpoint --------------------------------
# Default: local Ollama (`ollama pull qwen3:4b-instruct-2507-q4_K_M`)
RAG_LLM_BASE_URL=http://localhost:11434/v1
RAG_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
RAG_LLM_API_KEY=ollama
RAG_LLM_TEMPERATURE=0.0

# --- Using OpenAI instead (uncomment) ----------------------------------------------------
# RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_API_KEY=sk-...
# RAG_EMBEDDING_QUERY_PREFIX=
# RAG_EMBEDDING_DOCUMENT_PREFIX=
# RAG_MIN_RELEVANCE=0.25        # re-calibrate: similarity scales differ between embedding models
# RAG_LLM_BASE_URL=https://api.openai.com/v1
# RAG_LLM_MODEL=gpt-4o-mini
# RAG_LLM_API_KEY=sk-...
# ...and set RAG_KEEP_ALIVE= (empty) in the Speed section below; OpenAI rejects unknown parameters.

# --- Pipeline ---------------------------------------------------------------------------
RAG_DATA_DIR=data
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=6
RAG_HYBRID_SEARCH=true
RAG_DOCUMENT_LEAD_CHUNKS=1
RAG_DOCUMENT_CONTEXT=true
RAG_MIN_RELEVANCE=0.55
RAG_MAX_UPLOAD_MB=50
RAG_MAX_CHUNKS_PER_DOCUMENT=20000   # ~30 min of embedding on a 4 GB laptop GPU; larger files are rejected

# --- Speed --------------------------------------------------------------------------------
RAG_LLM_MAX_TOKENS=350
RAG_KEEP_ALIVE=30m          # Ollama only: keep models loaded. Set empty for OpenAI and other providers.
RAG_WARMUP=true             # load models in the background at startup
RAG_ANSWER_CACHE_SIZE=256   # repeated questions are answered instantly

# --- Logging ------------------------------------------------------------------------------
RAG_LOG_FORMAT=text         # "json" = one JSON object per line, for log shippers
RAG_LOG_LEVEL=INFO
